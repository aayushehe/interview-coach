# Copy this file to .env. setup-database.ps1 writes DATABASE_URL for you.
PORT=8080
DATABASE_URL=postgres://coach:<generated-password>@localhost:5432/interview_coach
# AI provider (optional keys, never commit your real .env)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Needed only when you deploy; locally a secret file is created automatically
# AUTH_SECRET=
